DEPLOY_ENV=staging
# Staging is published through a Cloudflare Tunnel; production uses no Cloudflare
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

# The web goes through the Cloudflare Tunnel; fgv-infra-deploy's .env names it ARCHIVE_WEB_HOST
WEB_HOST=archive-staging.example.org
# The API, for /docs; through the tunnel on staging
API_HOST=archive-api-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-archive-server:develop
WEB_IMAGE=bloomper/fgv-archive-web:develop
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=archive
MYSQL_USER=archive

# CPUs the worker may use while reading files and rendering previews
WORKER_CPUS=1

# Requests for access to restricted files are emailed to the editors; staging's mail goes to fgv-infra-deploy's Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
SPEXREGISTER_WEB_URL=https://register-staging.example.org
FGV_REVIVAL_WEB_URL=https://revival-staging.example.org
SPEXIFY_WEB_URL=https://spexify-staging.example.org
SPEXFLIX_WEB_URL=https://spexflix-staging.example.org
SPEXGRAM_WEB_URL=https://spexgram-staging.example.org
API_IMPORT_SAMPLE_DATA=true
API_SAMPLE_DATA_SIZE=small

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.archive@example.org
FEEDBACK_EMAIL=feedback.archive@example.org
UMAMI_WEBSITE_ID=
