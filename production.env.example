DEPLOY_ENV=production
# Production uses no Cloudflare Tunnel: it sits behind its own reverse proxy (see README, Production)
COMPOSE_FILE=compose.yaml

# Served by production's reverse proxy; fgv-infra-deploy's .env names the web ARCHIVE_WEB_HOST
WEB_HOST=archive.example.org
# The API: GraphQL, uploads, downloads, share links and /docs
API_HOST=archive-api.example.org
KEYCLOAK_HOST=auth.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-archive-server:1.0.0
WEB_IMAGE=bloomper/fgv-archive-web:1.0.0
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=archive
MYSQL_USER=archive

# CPUs the worker may use while reading files and rendering previews
WORKER_CPUS=1

# Requests for access to restricted files are emailed to the editors; the password is in secrets/SMTP_PASSWORD
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=noreply@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
SPEXREGISTER_WEB_URL=https://register.example.org
FGV_REVIVAL_WEB_URL=https://revival.example.org
SPEXIFY_WEB_URL=https://spexify.example.org
SPEXFLIX_WEB_URL=https://spexflix.example.org
SPEXGRAM_WEB_URL=https://spexgram.example.org
API_IMPORT_SAMPLE_DATA=false
API_SAMPLE_DATA_SIZE=small

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.archive@example.org
FEEDBACK_EMAIL=feedback.archive@example.org
UMAMI_WEBSITE_ID=
